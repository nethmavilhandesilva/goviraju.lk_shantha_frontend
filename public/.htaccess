# React single-page app: send unknown paths to index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /shantha_frontend/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /shantha_frontend/index.html [L]
</IfModule>
